#!/usr/bin/env bash
## Sway autostart — ported from HyDE/Hyprland

# Kill already running processes
_ps=(waybar mako swayidle swww-daemon nm-applet)
for _prs in "${_ps[@]}"; do
	if pidof "${_prs}" >/dev/null 2>&1; then
		killall -9 "${_prs}"
	fi
done

# Gnome keyring (must run before polkit/secret-consumers)
eval "$(gnome-keyring-daemon --start --components=gpg,pkcs11,secrets,ssh)"
export SSH_AUTH_SOCK

# Polkit agent
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Wallpaper daemon
swww-daemon &
sleep 0.3
# Restore last wallpaper if any
if [[ -d "$HOME/.config/backgrounds" ]]; then
	wall=$(find "$HOME/.config/backgrounds" -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.jpeg' \) | shuf -n1)
	[[ -n "$wall" ]] && swww img "$wall" --transition-type any &
fi

# GTK themes
~/.config/sway/scripts/gtkthemes &

# Notification daemon (mako)
~/.config/sway/scripts/notifications &

# Status bar (waybar)
~/.config/sway/scripts/statusbar &

# Network applet
nm-applet --indicator &

# MPD
mpd 2>/dev/null &

# Idle / lock daemon (replaces hypridle)
swayidle -w -C "$HOME/.config/sway/swayidle.conf" &
