#!/bin/bash
## Display mode picker — Sway port (uses swaymsg)

MONITORS=($(swaymsg -t get_outputs | jq -r '.[].name'))
LAPTOP=${MONITORS[0]}
EXTERNALS=("${MONITORS[@]:1}")

MODE=$(yad --title="Display Mode" --width=450 --height=300 --center --list \
  --column="Mode" --column="Description" \
  "Normal" "Each screen is independent" \
  "Presentation" "Mirror primary to all" \
  "Selective" "Mirror primary to selected monitor" \
  --button=Apply:0 --button=Cancel:1)

[ $? -ne 0 ] && exit 0
MODE=$(echo "$MODE" | awk -F'|' '{print $1}')

set_normal_mode() {
	for ext in "${EXTERNALS[@]}"; do
		swaymsg "output $ext enable"
	done
}

set_presentation_mode() {
	for ext in "${EXTERNALS[@]}"; do
		swaymsg "output $ext enable position 0 0"
	done
}

set_selective_mode() {
	CHOICE=$(yad --title="Select Monitor to Mirror" --width=450 --height=300 --center --list \
		--column="Monitor" "${EXTERNALS[@]}" --button=Select:0 --button=Cancel:1)
	[ $? -ne 0 ] && exit 0
	TARGET=$(echo "$CHOICE" | awk -F'|' '{print $1}')
	swaymsg "output $TARGET enable position 0 0"
}

case "$MODE" in
	Normal)       set_normal_mode ;;
	Presentation) set_presentation_mode ;;
	Selective)    set_selective_mode ;;
esac
